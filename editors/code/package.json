{
  "name": "rgc-lang",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "rgc-dev",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgc-lang/analyzer.git"
  },
  "homepage": "https://github.com/rgc-lang/analyzer#readme",
  "bugs": {
    "url": "https://github.com/rgc-lang/analyzer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "rgc",
    "compiler",
    "language",
    "llvm",
    "lsp"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:rgc",
    "onCommand:rgc.build",
    "onCommand:rgc.run",
    "onCommand:rgc.test",
    "onCommand:rgc.restartServer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rgc",
        "aliases": [
          "RGC",
          "rgc"
        ],
        "extensions": [
          ".rg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rgc",
        "scopeName": "source.rgc",
        "path": "./syntaxes/rgc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rgc",
        "path": "./snippets/rgc.json"
      }
    ],
    "commands": [
      {
        "command": "rgc.build",
        "title": "%command.build.title%",
        "category": "RGC"
      },
      {
        "command": "rgc.run",
        "title": "%command.run.title%",
        "category": "RGC"
      },
      {
        "command": "rgc.test",
        "title": "%command.test.title%",
        "category": "RGC"
      },
      {
        "command": "rgc.restartServer",
        "title": "%command.restart.title%",
        "category": "RGC"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rgc.build",
          "group": "rgc@1"
        },
        {
          "command": "rgc.run",
          "group": "rgc@2"
        },
        {
          "command": "rgc.test",
          "group": "rgc@3"
        }
      ],
      "commandPalette": [
        {
          "command": "rgc.restartServer"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "rgc.compilerPath": {
          "type": "string",
          "default": "rgc",
          "markdownDescription": "%config.compilerPath.description%"
        },
        "rgc.lsp.serverPath": {
          "type": "string",
          "default": "rgc-analyzer",
          "markdownDescription": "%config.serverPath.description%"
        },
        "rgc.lsp.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.serverArgs.description%"
        },
        "rgc.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "%config.trace.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "vsce package --out rgc-lang.vsix",
    "publish:ovsx": "ovsx publish rgc-lang.vsix --trusted-publishing"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "ovsx": "^1.3.0",
    "typescript": "^5.4.0"
  }
}
