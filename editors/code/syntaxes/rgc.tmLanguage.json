{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RGC",
  "scopeName": "source.rgc",
  "patterns": [
    { "include": "#declarations" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#borrow" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "declarations": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.rgc" },
            "2": { "name": "entity.name.function.rgc" }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.rgc" },
            "2": { "name": "entity.name.type.rgc" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.rgc" },
            "2": { "name": "entity.name.type.rgc" }
          }
        },
        {
          "match": "\\b(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.rgc" },
            "2": { "name": "entity.name.type.rgc" }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.rgc" },
            "2": { "name": "entity.name.module.rgc" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rgc",
          "match": "#.*$"
        },
        {
          "name": "comment.block.rgc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rgc",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.rgc" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.rgc" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.rgc",
              "match": "\\\\[\"nrt0\\\\]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rgc",
          "match": "\\b(0[xX][0-9a-fA-F_]+|\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?)\\b"
        }
      ]
    },
    "borrow": {
      "patterns": [
        {
          "name": "keyword.operator.borrow.rgc",
          "match": "@var\\b"
        },
        {
          "name": "keyword.operator.borrow.rgc",
          "match": "@"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rgc",
          "match": "\\b(if|elif|else|for|in|while|break|continue|pass|return|match|case|from|public)\\b"
        },
        {
          "name": "keyword.operator.rgc",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.self.rgc",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.rgc",
          "match": "\\b(int|float|bool|str)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rgc",
          "match": "\\b(True|False|None)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.rgc",
          "match": "\\b(print|range|to_string|args|read_file|write_file|system|len)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rgc",
          "match": "=>|->|==|!=|<=|>=|<<|>>|\\*\\*|//|\\+=|-=|\\*=|/=|=|<|>|\\+|-|\\*|/|%|&|\\||\\^|!"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.rgc",
          "match": "[(){}\\[\\],:.;]"
        }
      ]
    }
  }
}